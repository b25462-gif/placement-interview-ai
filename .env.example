# ============================================================
# Student Placement Interview AI - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values

# ----- GROQ API -----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2048

# ----- EMBEDDING MODEL -----
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Options: all-MiniLM-L6-v2 | all-mpnet-base-v2 | paraphrase-multilingual-MiniLM-L12-v2

# ----- VECTOR STORE -----
VECTOR_STORE_TYPE=chroma
# Options: chroma | faiss
CHROMA_PERSIST_DIR=./vector_store/chroma_db
FAISS_INDEX_PATH=./vector_store/faiss_index

# ----- RAG SETTINGS -----
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# ----- MCP SERVER -----
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_SERVER_NAME=placement-interview-mcp

# ----- FASTAPI BACKEND -----
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_SECRET_KEY=change_this_to_a_random_secret_key_in_production
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ----- STREAMLIT FRONTEND -----
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000

# ----- DATA PATHS -----
DATA_DIR=./data
RESUMES_DIR=./data/resumes
JOB_DESCRIPTIONS_DIR=./data/job_descriptions
QUESTION_BANK_DIR=./data/question_bank

# ----- INTERVIEW SETTINGS -----
MAX_INTERVIEW_QUESTIONS=10
INTERVIEW_DIFFICULTY=medium
# Options: easy | medium | hard
FEEDBACK_DETAIL_LEVEL=detailed
# Options: brief | detailed | comprehensive
